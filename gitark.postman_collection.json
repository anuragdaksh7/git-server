    },
    {
      "key": "loginPassword",
      "value": "12345678",
      "type": "string"
    },
    {
      "key": "repoName",
      "value": "hello",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "repoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "treePath",
      "value": "",
      "type": "string"
    },
    {
      "key": "ref",
      "value": "HEAD",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Service liveness check.",
      "item": [
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Returns the plain text `git server` with a 200."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('body is \"git server\"', () => pm.expect(pm.response.text()).to.eql('git server'));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "User",
      "description": "Account creation, login and profile.",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{signupName}}\",\n  \"username\": \"{{signupUsername}}\",\n  \"email\": \"{{signupEmail}}\",\n  \"password\": \"{{signupPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/user/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "create"
              ]
            },
            "description": "Creates a user. All four fields are required; email and username must be unique. Also kicks off creation of `/srv/git/users/<user-id>/`.\n\nReturns `{ \"data\": { \"id\": \"<uuid>\" } }`. 400 on invalid body, 500 if the user already exists."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.id) {",
                  "  pm.collectionVariables.set('userId', body.data.id);",
                  "  console.log('userId =', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Log In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/user/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "login"
              ]
            },
            "description": "Authenticates with email + password. Responds with `{ \"data\": { \"user\": { token, id, name, email, username } } }` and also sets an `Authorization` cookie (HttpOnly, 30 days) that the middleware accepts as an alternative to the Bearer header.\n\nThe test script stores the JWT in the `token` collection variable for all protected requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('token returned', () => pm.expect(body.data.user.token).to.be.a('string').and.not.empty);",
                  "",
                  "pm.collectionVariables.set('token', body.data.user.token);",
                  "pm.collectionVariables.set('userId', body.data.user.id);",
                  "console.log('token acquired for user', body.data.user.email);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "me"
              ]
            },
            "description": "Returns the authenticated user: `{ \"data\": { id, name, email, username, profilePicture, role } }`. Requires `Authorization: Bearer {{token}}` (or the Authorization cookie). 401 when the token is missing/invalid."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('has user id', () => pm.expect(body.data.id).to.be.a('string'));",
                  "pm.collectionVariables.set('userId', body.data.id);"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Repository",
      "description": "Repository management. All routes require auth.",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{repoName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/repo/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "repo",
                "create"
              ]
            },
            "description": "Creates a repo for the authenticated user. Name must match `^[A-Za-z0-9_.-]{1,100}$` (no `.` / `..`) and be unique per user. Rows go to `repositories`, and a bare repo is initialised at `/srv/git/users/<user-id>/<name>.git` via `git init --bare`.\n\nReturns `{ \"data\": { id, name, createdAt } }`. 400 on invalid/duplicate name."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.id) {",
                  "  pm.collectionVariables.set('repoId', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/repo/list",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "repo",
                "list"
              ]
            },
            "description": "Lists the authenticated user's repos, newest first. Returns `{ \"data\": [ { id, name, createdAt } ] }`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('data is an array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Tree",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/repo/{{repoName}}/tree?ref={{ref}}&path={{treePath}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "repo",
                "{{repoName}}",
                "tree"
              ],
              "query": [
                {
                  "key": "ref",
                  "value": "{{ref}}",
                  "description": "Branch, tag or commit-ish. Empty means HEAD."
                },
                {
                  "key": "path",
                  "value": "{{treePath}}",
                  "description": "Directory to list. Empty (or /) means the repository root."
                }
              ]
            },
            "description": "Lists exactly one level of the repo tree, never descendants. `ref` picks the branch/tag/commit-ish (empty = HEAD) and `path` picks the node (empty = root). Pass a returned entry's `path` back in to descend.\n\nReturns `{ \"data\": [ { fileMode, objectType, sha1Hash, fileName, path } ] }`.\n\n- empty repo with ref omitted/HEAD -> `200` with `[]`\n- unknown repo / path is a file or missing / unknown ref -> `404`\n- `..`, `.`, `//` or `\\` in path -> `400 invalid path`\n- leading `-` or whitespace in ref -> `400 invalid branch name`"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('data is an array', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "",
                  "const entries = pm.response.json().data;",
                  "const firstDir = entries.find(e => e.objectType === 'tree');",
                  "if (firstDir) { console.log('descend with treePath =', firstDir.path); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Refs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/repo/{{repoName}}/refs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "repo",
                "{{repoName}}",
                "refs"
              ]
            },
            "description": "Returns the branch HEAD points at plus every branch and tag in the repo: `{ \"data\": { defaultBranch, branches, tags } }`.\n\n`defaultBranch` comes from `git symbolic-ref --short HEAD` and works even for an empty repo, where `branches` is just that one name and `tags` is `[]`. Unknown repo -> `404`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test('has a default branch', () => pm.expect(data.defaultBranch).to.be.a('string').and.not.empty);",
                  "pm.test('branches is an array', () => pm.expect(data.branches).to.be.an('array'));",
                  "pm.test('tags is an array', () => pm.expect(data.tags).to.be.an('array'));",
                  "if (data.defaultBranch) { pm.collectionVariables.set('ref', data.defaultBranch); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Commits",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/repo/{{repoName}}/commits/{{ref}}?path={{treePath}}&limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "repo",
                "{{repoName}}",
                "commits",
                "{{ref}}"
              ],
              "query": [
                {
                  "key": "path",
                  "value": "{{treePath}}",
                  "description": "Optional: only commits touching this directory."
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Optional: 1-200, default 50."
                }
              ]
            },
            "description": "Lists commits reachable from `:branch` (branch, tag or full SHA), newest first. `path` restricts history to commits touching that directory; `limit` is 1-200 (default 50).\n\nReturns `{ \"data\": [ { sha, author, date, message } ] }`.\n\n- empty repo -> `200` with `[]`\n- unknown repo / unknown branch -> `404`\n- leading `-` or whitespace in branch -> `400 invalid branch name`\n- `..`, `.`, `//` or `\\` in path -> `400 invalid path`"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('data is an array', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "const commits = pm.response.json().data;",
                  "if (commits.length) {",
                  "  pm.test('commit shape', () => {",
                  "    pm.expect(commits[0]).to.have.all.keys('sha', 'author', 'date', 'message');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
